      "source": [
        "# Solar Filament Segmentation 2026\n",
        "Kaggle entry notebook: clone the GitHub project, train, and generate submission."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "!git clone https://github.com/KLsatorlac2/solar-filament-segmentation-2026.git /kaggle/working/solar-filament-segmentation-2026\n",
        "%cd /kaggle/working/solar-filament-segmentation-2026\n",
        "!pip install -q -r requirements.txt"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "DATA_ROOT = \"/kaggle/input/competitions/filament-segmentation-2026/MAGFiLO_1.0_Kaggle_2026\"\n",
        "OUTPUT_DIR = \"/kaggle/working/outputs\"\n",
        "LOSS = \"DiceLoss\"\n",
        "MODEL = \"unet\""
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "!python -m scripts.train \
            --config configs/config.yaml \
            --data_root {DATA_ROOT} \
            --output_dir {OUTPUT_DIR} \
            --loss {LOSS} \
            --model {MODEL}"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "!python -m scripts.predict \
            --config configs/config.yaml \
            --data_root {DATA_ROOT} \
            --checkpoint {OUTPUT_DIR}/best_unet.pth \
            --output {OUTPUT_DIR}/submission.csv \
            --model {MODEL}"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "import pandas as pd\n",
        "submission = pd.read_csv(f\"{OUTPUT_DIR}/submission.csv\")\n",
        "submission.head()"
      ]
    }
