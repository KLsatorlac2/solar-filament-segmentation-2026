      "source": [
        "# Solar Filament Segmentation 2026\n",
        "Kaggle entry notebook: clone the GitHub project, train, and generate submission."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "!git clone https://github.com/KLsatorlac2/solar-filament-segmentation-2026.git /kaggle/working/solar-filament-segmentation-2026\n",
        "%cd /kaggle/working/solar-filament-segmentation-2026\n",
        "!pip install -q -r requirements.txt"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "DATA_ROOT = \"/kaggle/input/competitions/filament-segmentation-2026/MAGFiLO_1.0_Kaggle_2026\"\n",
        "OUTPUT_DIR = \"/kaggle/working/outputs\"\n",
        "LOSS = \"bce_dice\"\n",
        "MODEL = \"unet_plus_plus\""
      ]
    },
//     {
//       "cell_type": "code",
//       "execution_count": null,
//       "metadata": {},
//       "outputs": [],
//       "source": [
//         "!python -m scripts.train --config configs/config.yaml --data_root {DATA_ROOT} --output_dir {OUTPUT_DIR} --loss {LOSS} --model {MODEL}"
//       ]
//     },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "import shutil\n",
        "from pathlib import Path\n",
        "\n",
        "'''src使用对应的模型权重，这里使用v0.5.0实验的best_model.pth，
        因为Kaggleoutput下载权重后会压缩成zip文件，这里upload权重后作为数据集挂载到input，但是文件是 PyTorch 2.x 默认的 ZIP-based serialization，需要重新打包'''\n"
        "src = Path('/kaggle/input/datasets/<YOUR_NAME>/best-model-pth/best_model')\n",
        "dst = Path('/kaggle/working/best_model.pth')\n",
        "\n",
        "print(f'Checkpoint source: {src}')\n",
        "\n",
        "shutil.make_archive(\n",
        "    '/kaggle/working/best_model',\n",
        "    'zip',\n",
        "    src.parent,\n",
        "    src.name,\n",
        ")\n",
        "\n",
        "zip_path = Path('/kaggle/working/best_model.zip')\n",
        "zip_path.rename(dst)\n",
        "\n",
        "print(f'Checkpoint: {dst}')\n",
        "print(f'Size: {dst.stat().st_size / 1024 / 1024:.2f} MB')"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "CHECKPOINT = f\"/kaggle/working/best_model.pth\"\n",
        "\n",
        "!python -m scripts.evaluate_postprocess --config configs/config.yaml --data_root {DATA_ROOT} --checkpoint {CHECKPOINT}"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "THRESHOLD = 0.4\n",
        "MIN_AREA = 100\n",
        "\n",
        "!python -m scripts.predict --config configs/config.yaml --data_root {DATA_ROOT} --checkpoint {CHECKPOINT} --threshold {THRESHOLD} --min_area {MIN_AREA} --output {OUTPUT_DIR}/submission.csv"

      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "import pandas as pd\n",
        "submission = pd.read_csv(f\"{OUTPUT_DIR}/submission.csv\")\n",
        "print(f\"Submission rows: {len(submission)}\")\n",
        "submission.head()"
      ]
    }
